# ==========================================
# SwasthyaSetu backend environment template
# Copy this file to backend/.env and replace
# the placeholder values with your own.
# ==========================================

# Runtime / deployment
PORT=5000
FLASK_DEBUG=true
PUBLIC_BACKEND_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
UPLOAD_FOLDER=

# Application secrets
SECRET_KEY=replace_with_a_long_random_secret_key
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret

# Database
# SQLite is now the default database engine.
# DB_PATH is the runtime database file the backend reads and writes.
# SQLITE_SEED_PATH is copied into DB_PATH automatically on first boot
# if DB_PATH does not exist yet.
#
# Local development defaults:
#   DB_PATH=data/telemedicine.sqlite3
#   SQLITE_SEED_PATH=seed/telemedicine.seed.sqlite3
#   SQLITE_SCHEMA_PATH=seed/telemedicine.schema.sql
#
# Docker / Render example:
#   DB_PATH=/app/data/telemedicine.sqlite3
#   SQLITE_SEED_PATH=/app/seed/telemedicine.seed.sqlite3
#   SQLITE_SCHEMA_PATH=/app/seed/telemedicine.schema.sql
DB_PATH=
SQLITE_SEED_PATH=
SQLITE_SCHEMA_PATH=

# Email notifications (optional but recommended for OTP and approval mail)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_app_password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=your_email@example.com

# Twilio SMS notifications (optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567

# AI integrations
# GOOGLE_API_KEY is reserved for Gemini-based features.
# GROQ_API_KEY is required for the chatbot route.
GOOGLE_API_KEY=your_google_ai_api_key
GROQ_API_KEY=your_groq_api_key

# Maps and nearby hospital lookup
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
